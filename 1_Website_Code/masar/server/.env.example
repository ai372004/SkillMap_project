# Copy this file to .env and fill in real values.

PORT=5000

# Local MongoDB, or a MongoDB Atlas connection string in production
MONGO_URI=mongodb://127.0.0.1:27017/masar

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Front-end address allowed to call the API (comma-separated for several)
CLIENT_URL=http://localhost:5173

# Used by "npm run create-admin" to create the first admin account
ADMIN_NAME=Masar Admin
ADMIN_EMAIL=admin@masar.test
ADMIN_PASSWORD=ChangeMe123!
